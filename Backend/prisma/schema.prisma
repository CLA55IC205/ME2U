// ME2U — Prisma schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
}

enum OrderStatus {
  PAYMENT_PENDING
  AWAITING_DISPATCH
  IN_TRANSIT
  DELIVERED
  DISPUTE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  ESCROWED
  RELEASED
  REFUNDED
}

enum WalletProvider {
  MTN
  AIRTEL
}

enum LedgerType {
  HOLD
  RELEASE
  REFUND
  SPLIT
}

enum DisputeStatus {
  OPEN
  RESOLVED_SELLER
  RESOLVED_BUYER
  RESOLVED_SPLIT
}

model User {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  role      UserRole
  createdAt DateTime @default(now())

  buyerOrders  Order[]   @relation("BuyerOrders")
  sellerOrders Order[]   @relation("SellerOrders")
  disputes     Dispute[]
}

model Order {
  id              String         @id @default(uuid())
  publicId        String         @unique
  buyerId         String
  sellerId        String
  itemDescription String
  amountZmw       Decimal        @db.Decimal(12, 2)
  status          OrderStatus    @default(PAYMENT_PENDING)
  paymentProvider WalletProvider

  origin        String?
  destination   String
  courier       String?
  trackingNumber String?
  notes         String?

  dispatchedAt     DateTime?
  estimatedAt      DateTime?
  arrivalAt        DateTime?
  buyerConfirmedAt DateTime?
  autoReleaseAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  buyer   User     @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller  User     @relation("SellerOrders", fields: [sellerId], references: [id])
  payment Payment?
  dispute Dispute?
  events  DeliveryEvent[]
  ledger  EscrowLedgerEntry[]
}

model Payment {
  id         String        @id @default(uuid())
  orderId    String        @unique
  status     PaymentStatus @default(PENDING)
  provider   WalletProvider
  escrowedAt DateTime?
  releasedAt DateTime?
  createdAt  DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model Dispute {
  id          String        @id @default(uuid())
  orderId     String        @unique
  raisedById  String
  reason      String
  detail      String?
  status      DisputeStatus @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())

  order     Order @relation(fields: [orderId], references: [id])
  raisedBy  User  @relation(fields: [raisedById], references: [id])
}

model DeliveryEvent {
  id         String   @id @default(uuid())
  orderId    String
  title      String
  detail     String?
  occurredAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model EscrowLedgerEntry {
  id        String     @id @default(uuid())
  orderId   String
  type      LedgerType
  amountZmw Decimal    @db.Decimal(12, 2)
  note      String?
  createdAt DateTime   @default(now())

  order Order @relation(fields: [orderId], references: [id])
}
