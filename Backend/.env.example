# PostgreSQL connection (Prisma)
DATABASE_URL="postgresql://me2u:me2u@localhost:5432/me2u?schema=public"

# API
PORT=3001
NODE_ENV=development

# Comma-separated origins for CORS (frontend file:// or local server)
CORS_ORIGIN="http://localhost:5500,http://127.0.0.1:5500,null"

# Dev auth: set to "true" to allow X-User-Id header without JWT
AUTH_DEV_MODE=true
